<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram name="Personal Agents Six Archetypes">
    <mxGraphModel dx="1200" dy="760" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="690" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title & Subtitle -->
        <mxCell id="title" value="Personal Agents 六大应用形态全景（2026）" style="text;html=1;align=center;verticalAlign=middle;fontSize=22;fontStyle=1;fontColor=#0f172a;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="20" width="1040" height="36" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="按「交互入口 × 运行位置 × 数据与控制权边界」划分，覆盖主流商业产品与开源生态" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#475569;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="56" width="1040" height="24" as="geometry" />
        </mxCell>

        <!-- Row 1 Group Label -->
        <mxCell id="row1_tag" value="通用个人工作与日常代理（多通道 / 全场景）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=13;fontStyle=1;fontColor=#334155;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="96" width="1040" height="28" as="geometry" />
        </mxCell>

        <!-- Card 1: IM Gateway + Self-Hosted -->
        <mxCell id="c1" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#eff6ff;strokeColor=#3b82f6;strokeWidth=2;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="136" width="330" height="236" as="geometry" />
        </mxCell>
        <mxCell id="c1_badge" value="01 · IM 网关 + 本地常驻型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2563eb;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#ffffff;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c1">
          <mxGeometry x="16" y="14" width="298" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c1_desc" value="&lt;b&gt;入口与运行：&lt;/b&gt;WhatsApp / Telegram / Slack 接入；本地 Mac mini、VPS 或边缘沙盒 7×24 常驻&#xa;&lt;b&gt;代表：&lt;/b&gt;OpenClaw、Hermes Agent、NanoClaw、ZeroClaw、IronClaw、Moltworker&#xa;&lt;b&gt;核心优势：&lt;/b&gt;数据主权、模型可换、Heartbeat/Cron 主动触发&#xa;&lt;b&gt;核心风险：&lt;/b&gt;宿主机权限过大、凭据泄露、大厂 OAuth 封禁" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;spacingRight=4;fontSize=13;fontColor=#1e293b;lineHeight=148;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c1">
          <mxGeometry x="16" y="58" width="298" height="168" as="geometry" />
        </mxCell>

        <!-- Card 2: Managed Cloud Agent Computer -->
        <mxCell id="c2" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f0fdf4;strokeColor=#22c55e;strokeWidth=2;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="395" y="136" width="330" height="236" as="geometry" />
        </mxCell>
        <mxCell id="c2_badge" value="02 · 大厂统一工作台 + 云端虚机型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#16a34a;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#ffffff;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c2">
          <mxGeometry x="16" y="14" width="298" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c2_desc" value="&lt;b&gt;入口与运行：&lt;/b&gt;统一 App + 短信/邮件/定时任务；云端隔离 VM 或桌面本地微虚机持续执行&#xa;&lt;b&gt;代表：&lt;/b&gt;统一 Claude (Cowork)、ChatGPT Agent/Pulse、Gemini Tasks、Meta Muse、Manus&#xa;&lt;b&gt;核心优势：&lt;/b&gt;零运维、深度打通邮箱/日历/支付生态&#xa;&lt;b&gt;核心风险：&lt;/b&gt;平台黑盒、隐私标注争议、第三方电商封杀" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;spacingRight=4;fontSize=13;fontColor=#1e293b;lineHeight=148;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c2">
          <mxGeometry x="16" y="58" width="298" height="168" as="geometry" />
        </mxCell>

        <!-- Card 3: Agentic Browser -->
        <mxCell id="c3" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fffbeb;strokeColor=#f59e0b;strokeWidth=2;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="750" y="136" width="330" height="236" as="geometry" />
        </mxCell>
        <mxCell id="c3_badge" value="03 · 浏览器原生与会话复用型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d97706;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#ffffff;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c3">
          <mxGeometry x="16" y="14" width="298" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c3_desc" value="&lt;b&gt;入口与运行：&lt;/b&gt;AI 浏览器侧栏或 CDP 接管；直接复用用户已登录态 Cookie 与 DOM&#xa;&lt;b&gt;代表：&lt;/b&gt;Perplexity Comet、ChatGPT Atlas、Dia、BrowserOS、browser-use、OpenCLI&#xa;&lt;b&gt;核心优势：&lt;/b&gt;绕过无 API / 无 OAuth 的 Web 最后一公里&#xa;&lt;b&gt;核心风险：&lt;/b&gt;网页间接提示注入高发、反爬与风控拦截" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;spacingRight=4;fontSize=13;fontColor=#1e293b;lineHeight=148;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c3">
          <mxGeometry x="16" y="58" width="298" height="168" as="geometry" />
        </mxCell>

        <!-- Row 2 Group Label -->
        <mxCell id="row2_tag" value="深度系统控制与持续上下文感知（开发者 / OS 底层 / 物理世界）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#cbd5e1;fontSize=13;fontStyle=1;fontColor=#334155;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="1">
          <mxGeometry x="40" y="392" width="1040" height="28" as="geometry" />
        </mxCell>

        <!-- Card 4: Coding Harness Spillover -->
        <mxCell id="c4" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#f5f3ff;strokeColor=#8b5cf6;strokeWidth=2;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="432" width="330" height="236" as="geometry" />
        </mxCell>
        <mxCell id="c4_badge" value="04 · 终端 / Coding Harness 外溢型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#7c3aed;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#ffffff;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c4">
          <mxGeometry x="16" y="14" width="298" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c4_desc" value="&lt;b&gt;入口与运行：&lt;/b&gt;CLI / TUI / 桌面壳；以 bash + 文件读写 + Skills + MCP 接管知识工作&#xa;&lt;b&gt;代表：&lt;/b&gt;Claude Code、Codex CLI、OpenCode、Pi、Goose、Paperclip、Obsidian Skills&#xa;&lt;b&gt;核心优势：&lt;/b&gt;确定性与可复现性最高、工具生态最成熟&#xa;&lt;b&gt;核心风险：&lt;/b&gt;偏向技术用户、难以触达封闭移动端 App" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;spacingRight=4;fontSize=13;fontColor=#1e293b;lineHeight=148;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c4">
          <mxGeometry x="16" y="58" width="298" height="168" as="geometry" />
        </mxCell>

        <!-- Card 5: OS-Native & Mobile GUI -->
        <mxCell id="c5" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#ecfeff;strokeColor=#06b6d4;strokeWidth=2;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="395" y="432" width="330" height="236" as="geometry" />
        </mxCell>
        <mxCell id="c5_badge" value="05 · OS 原生与手机端 GUI 型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#0891b2;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#ffffff;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c5">
          <mxGeometry x="16" y="14" width="298" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c5_desc" value="&lt;b&gt;入口与运行：&lt;/b&gt;系统语音/侧键唤起；通过 App Intents、无障碍树或视觉点击跨 App 操作&#xa;&lt;b&gt;代表：&lt;/b&gt;Apple Intelligence、Android Gemini、荣耀 YOYO、豆包手机助手、Cua、nanoMuse&#xa;&lt;b&gt;核心优势：&lt;/b&gt;手握系统级入口、设备传感与高频移动场景&#xa;&lt;b&gt;核心风险：&lt;/b&gt;超级 App 壁垒反制、法务责任保守、端侧算力受限" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;spacingRight=4;fontSize=13;fontColor=#1e293b;lineHeight=148;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c5">
          <mxGeometry x="16" y="58" width="298" height="168" as="geometry" />
        </mxCell>

        <!-- Card 6: Ambient Sensing & Wearables -->
        <mxCell id="c6" value="" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#fdf2f8;strokeColor=#ec4899;strokeWidth=2;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="750" y="432" width="330" height="236" as="geometry" />
        </mxCell>
        <mxCell id="c6_badge" value="06 · 持续感知、随身硬件与伴侣型" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#db2777;strokeColor=none;fontSize=14;fontStyle=1;fontColor=#ffffff;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c6">
          <mxGeometry x="16" y="14" width="298" height="34" as="geometry" />
        </mxCell>
        <mxCell id="c6_desc" value="&lt;b&gt;入口与运行：&lt;/b&gt;后台持续录屏/录音、可穿戴麦克风或家庭网关，主动发现上下文与任务&#xa;&lt;b&gt;代表：&lt;/b&gt;Screenpipe、Omi、Plaud、Limitless、Meta Home Link、MOERU AIRI&#xa;&lt;b&gt;核心优势：&lt;/b&gt;消除“用户手动喂上下文”的摩擦，沉淀真实工作流&#xa;&lt;b&gt;核心风险：&lt;/b&gt;隐私与社交边界极敏感、独立硬件易脱离软件生态" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;spacingRight=4;fontSize=13;fontColor=#1e293b;lineHeight=148;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="c6">
          <mxGeometry x="16" y="58" width="298" height="168" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
