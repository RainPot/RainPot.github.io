        </mxCell>
        <mxCell id="l2_b" value="上下文编译与 KV-Cache 稳定&#xa;前缀固化 · 工具状态机掩码" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a78bfa;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l2">
          <mxGeometry x="268" y="42" width="224" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l2_c" value="模型路由与回退网关&#xa;多厂商切换 · 成本预算控制" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#a78bfa;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l2">
