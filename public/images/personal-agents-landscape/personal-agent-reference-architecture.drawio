          <mxGeometry x="268" y="42" width="224" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l3_c" value="混合检索引擎与证据溯源&#xa;FTS5 + 向量 + 声明版本覆盖" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4ade80;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l3">
          <mxGeometry x="520" y="42" width="224" height="48" as="geometry" />
        </mxCell>

        <!-- Layer 4: Capabilities & Skills -->
        <mxCell id="l4" value="L4 · 能力扩展层（Skills + MCP + 原语工具）" style="swimlane;startSize=30;rounded=1;fillColor=#fffbeb;strokeColor=#d97706;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#b45309;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="480" width="760" height="104" as="geometry" />
        </mxCell>
        <mxCell id="l4_a" value="渐进式 Agent Skills&#xa;SKILL.md 发现 → 按需激活" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbbf24;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l4">
          <mxGeometry x="16" y="42" width="224" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l4_b" value="标准化连接器协议&#xa;MCP Servers · OpenCLI · AP2" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbbf24;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l4">
          <mxGeometry x="268" y="42" width="224" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l4_c" value="极简高频核心原语&#xa;read / write / edit / bash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#fbbf24;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l4">
          <mxGeometry x="520" y="42" width="224" height="48" as="geometry" />
        </mxCell>

        <!-- Layer 5: Execution Hands & Sandboxes -->
        <mxCell id="l5" value="L5 · 隔离执行面（Sandboxes &amp; Device Hands）" style="swimlane;startSize=30;rounded=1;fillColor=#ecfeff;strokeColor=#0891b2;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#0e7490;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="612" width="760" height="104" as="geometry" />
        </mxCell>
        <mxCell id="l5_a" value="计算与代码沙盒&#xa;Docker · Apple VM · nspawn · WASM" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22d3ee;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l5">
          <mxGeometry x="16" y="42" width="224" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l5_b" value="浏览器与 Web 执行&#xa;CDP 代理 · Playwright · 云浏览器" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22d3ee;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l5">
          <mxGeometry x="268" y="42" width="224" height="48" as="geometry" />
        </mxCell>
        <mxCell id="l5_c" value="跨端物理与 GUI 手脚&#xa;手机/桌面 GUI · Home Link 硬件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#22d3ee;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l5">
          <mxGeometry x="520" y="42" width="224" height="48" as="geometry" />
        </mxCell>

        <!-- Right Vertical Pillar 1: L6 Security & Trust Boundary -->
        <mxCell id="sec_pillar" value="横切面 A · 纵深安全与凭据边界" style="swimlane;startSize=32;rounded=1;fillColor=#fef2f2;strokeColor=#dc2626;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#991b1b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="830" y="92" width="250" height="300" as="geometry" />
        </mxCell>
        <mxCell id="sec_body" value="• &lt;b&gt;Agent Vault 网关&lt;/b&gt;&#xa;  凭据外置，按 Host 注入&#xa;&#xa;• &lt;b&gt;Rule of Two 隔离&lt;/b&gt;&#xa;  切断不可信输入→高危写操作&#xa;&#xa;• &lt;b&gt;细粒度策略与限流&lt;/b&gt;&#xa;  域名白名单 · 消费/删信上限&#xa;&#xa;• &lt;b&gt;HITL 审批与审计&lt;/b&gt;&#xa;  付款/发信/外发必须确认" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;fontSize=13;fontColor=#7f1d1d;lineHeight=145;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="sec_pillar">
          <mxGeometry x="8" y="38" width="234" height="252" as="geometry" />
        </mxCell>

        <!-- Right Vertical Pillar 2: L6 Proactive & Self-Evolution -->
        <mxCell id="pro_pillar" value="横切面 B · 主动调度与自进化" style="swimlane;startSize=32;rounded=1;fillColor=#fdf2f8;strokeColor=#db2777;strokeWidth=2;fontSize=13;fontStyle=1;fontColor=#9d174d;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="830" y="416" width="250" height="300" as="geometry" />
        </mxCell>
        <mxCell id="pro_body" value="• &lt;b&gt;Heartbeat &amp; Cron&lt;/b&gt;&#xa;  定时巡检 · 事件 Webhook 唤醒&#xa;&#xa;• &lt;b&gt;夜间整合（Dream）&lt;/b&gt;&#xa;  复盘对话 → 写回偏好与摘要&#xa;&#xa;• &lt;b&gt;Skill 自动沉淀&lt;/b&gt;&#xa;  复杂成功轨迹提炼为 SKILL.md&#xa;&#xa;• &lt;b&gt;安全回归门控&lt;/b&gt;&#xa;  演化前后校验抗注入，失败回滚" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;spacing=10;fontSize=13;fontColor=#831843;lineHeight=145;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="pro_pillar">
          <mxGeometry x="8" y="38" width="234" height="252" as="geometry" />
        </mxCell>

