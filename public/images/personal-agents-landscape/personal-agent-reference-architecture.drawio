        <!-- Layer 3: Memory & Context Substrate -->
        <mxCell id="l3" value="L3 · 分层记忆与人格配置层（Context Substrate）" style="swimlane;startSize=30;rounded=1;fillColor=#f0fdf4;strokeColor=#16a34a;strokeWidth=2;fontSize=14;fontStyle=1;fontColor=#15803d;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;container=1;pointerEvents=0;" vertex="1" parent="1">
          <mxGeometry x="40" y="348" width="760" height="104" as="geometry" />
        </mxCell>
        <mxCell id="l3_a" value="Markdown 身份与偏好档案&#xa;SOUL / USER / MEMORY.md" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#4ade80;fontSize=13;fontColor=#1e293b;fontFamily=PingFang SC,Microsoft YaHei,Helvetica,Arial;" vertex="1" parent="l3">
