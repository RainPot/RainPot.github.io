<mxfile host="drawio" version="31.0.2">
  <diagram name="三划分隔离与防篡改归档判定">
    <mxGraphModel dx="1000" dy="880" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="880" background="#ffffff">
      <root>
