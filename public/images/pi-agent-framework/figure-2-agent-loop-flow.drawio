<mxfile host="Electron" modified="2026-08-24T00:00:00.000Z" agent="Mozilla/5.0" version="21.0.0" type="device">
  <diagram id="pi-agent-loop" name="Pi Agent Loop Execution Flow">
    <mxGraphModel dx="1200" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1200" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Pi Agent Loop 单轮执行状态机与生命周期钩子" style="text;html=1;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=20;fontStyle=1;fontColor=#0f172a;" vertex="1" parent="1">
          <mxGeometry x="320" y="20" width="560" height="40" as="geometry" />
        </mxCell>

        <!-- Step 1: Prompt Input -->
        <mxCell id="step1" value="&lt;b&gt;1. 用户输入&lt;/b&gt;&lt;br&gt;agent.prompt(text)&lt;br&gt;进入内部队列" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e0e7ff;strokeColor=#6366f1;fontColor=#1e1b4b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="160" height="70" as="geometry" />
        </mxCell>

        <!-- Step 2: Context Transform -->
        <mxCell id="step2" value="&lt;b&gt;2. 上下文变换&lt;/b&gt;&lt;br&gt;transformContext()&lt;br&gt;历史消息裁剪与 RAG 注入" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#78350f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="260" y="100" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Step 3: Convert To LLM -->
        <mxCell id="step3" value="&lt;b&gt;3. 协议边界转译&lt;/b&gt;&lt;br&gt;convertToLlm()&lt;br&gt;过滤 UI 消息，生成 Message[]" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fef3c7;strokeColor=#f59e0b;fontColor=#78350f;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="490" y="100" width="190" height="70" as="geometry" />
        </mxCell>

        <!-- Step 4: LLM Stream -->
        <mxCell id="step4" value="&lt;b&gt;4. 模型流式推理&lt;/b&gt;&lt;br&gt;streamSimple() / stream()&lt;br&gt;发射 text_delta &amp; thinking_delta" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#10b981;fontColor=#064e3b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="730" y="100" width="200" height="70" as="geometry" />
        </mxCell>

        <!-- Decision: Has Tool Call? -->
        <mxCell id="dec_tool" value="包含工具调用&lt;br&gt;Tool Call ?" style="rhombus;whiteSpace=wrap;html=1;fillColor=#f1f5f9;strokeColor=#64748b;fontColor=#0f172a;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="980" y="85" width="150" height="100" as="geometry" />
        </mxCell>

        <!-- No Tool Branch: End Turn -->
        <mxCell id="step_end" value="&lt;b&gt;收尾检查&lt;/b&gt;&lt;br&gt;shouldStopAfterTurn()&lt;br&gt;发射 turn_end / agent_end" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e2e8f0;strokeColor=#64748b;fontColor=#1e293b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="965" y="260" width="180" height="70" as="geometry" />
        </mxCell>

        <!-- Tool Flow: Before Tool Call Hook -->
        <mxCell id="step_before" value="&lt;b&gt;5. 工具执行前拦截&lt;/b&gt;&lt;br&gt;beforeToolCall() Hook&lt;br&gt;权限门禁 / 敏感命令确认 / 参数预处理" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="380" width="240" height="75" as="geometry" />
        </mxCell>

        <!-- Tool Flow: Tool Execution -->
        <mxCell id="step_exec" value="&lt;b&gt;6. 执行工具逻辑&lt;/b&gt;&lt;br&gt;tool.execute(args, context)&lt;br&gt;支持 Sequential / Parallel 模式" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="430" y="380" width="230" height="75" as="geometry" />
        </mxCell>

        <!-- Tool Flow: After Tool Call Hook -->
        <mxCell id="step_after" value="&lt;b&gt;7. 工具执行后修正&lt;/b&gt;&lt;br&gt;afterToolCall() Hook&lt;br&gt;输出裁剪 / 错误降级 / 状态持久化" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fee2e2;strokeColor=#ef4444;fontColor=#7f1d1d;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="380" width="230" height="75" as="geometry" />
        </mxCell>

        <!-- Tool Flow: Append & Loop Back -->
        <mxCell id="step_append" value="&lt;b&gt;8. 追加 ToolResult &amp; 状态更新&lt;/b&gt;&lt;br&gt;将执行结果装载入 AgentContext&lt;br&gt;准备下一轮推理 (Next Turn)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dcfce7;strokeColor=#10b981;fontColor=#064e3b;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="150" y="240" width="230" height="75" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e_1_2" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="step1" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_2_3" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="step2" target="step3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_3_4" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="step3" target="step4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_4_dec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="step4" target="dec_tool">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dec_no" value="否 (纯文本回复)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="dec_tool" target="step_end">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_dec_yes" value="是 (发起工具调用)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#ef4444;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="dec_tool" target="step_before">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1055" y="418" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e_before_exec" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="step_before" target="step_exec">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_exec_after" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="step_exec" target="step_after">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_after_append" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748b;strokeWidth=2;" edge="1" parent="1" source="step_after" target="step_append">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_loopback" value="进入下一轮 Turn" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#10b981;strokeWidth=2;labelBackgroundColor=#ffffff;fontSize=11;" edge="1" parent="1" source="step_append" target="step2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>