<mxfile host="drawio" version="31.0.2">
  <diagram name="选择产物与提炼经验，依据不同">
    <mxGraphModel dx="1000" dy="830" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="830" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
