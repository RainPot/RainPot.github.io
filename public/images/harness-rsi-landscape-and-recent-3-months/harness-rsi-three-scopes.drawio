<?xml version='1.0' encoding='utf-8'?>
<mxfile host="drawio" version="31.0.2">
  <diagram name="Harness RSI 三层递归边界">
    <mxGraphModel dx="1000" dy="1060" grid="1" gridSize="10" page="1" pageWidth="1000" pageHeight="1060" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Harness RSI 三层作用面与不可改评测边界" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=32;fontColor=#1f3448;fontStyle=1;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="25" width="900" height="50" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="区分“改执行器”“改优化器”“联合改模型权重”，并将验证门禁与评测器锁在冻结区" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=21;fontColor=#42586e;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="78" width="900" height="36" as="geometry" />
        </mxCell>

        <mxCell id="meta" value="&lt;b&gt;元改进层（Meta-Improver / Evolver）&lt;/b&gt;&lt;div style=&quot;font-size:18px;margin-top:8px;line-height:1.45&quot;&gt;修改“如何诊断失败、提议补丁、选择分支与编排流程”的机制&lt;br&gt;代表：STOP · Hyperagents · HSI · Metaⁿ · VERSE · Harness² · RSIFlow · MetaShare&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#1f3448;fillColor=#fdf3e2;strokeColor=#c49346;strokeWidth=2;spacingLeft=22;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="135" width="560" height="175" as="geometry" />
        </mxCell>

        <mxCell id="mainline" value="&lt;b&gt;主线层（Executor Harness H）&lt;/b&gt;&lt;div style=&quot;font-size:18px;margin-top:8px;line-height:1.45&quot;&gt;修改 Agent Loop、Tool 接口、Observation、Context 与子类路由&lt;br&gt;代表：Meta-Harness · AHE · MGM · StarHarness · ModularRSI&lt;br&gt;SoL-Pi · RRSI · MESH-Harness · OO-Harness · HarnessMM&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#1f3448;fillColor=#e8f1fb;strokeColor=#728fb0;strokeWidth=2;spacingLeft=22;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="370" width="560" height="185" as="geometry" />
        </mxCell>

        <mxCell id="weights" value="&lt;b&gt;联合优化与外延层（Weights M + Playbook / Skills）&lt;/b&gt;&lt;div style=&quot;font-size:18px;margin-top:8px;line-height:1.45&quot;&gt;交替更新 Harness 与模型参数（SFT / RL），或编译可复用 Skill 库&lt;br&gt;代表：GEPA · ACE · SIA · Evo-Harness · MASS · Self-HPO · Frontier Data&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#1f3448;fillColor=#f3eefc;strokeColor=#8c72b0;strokeWidth=2;spacingLeft=22;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="50" y="615" width="560" height="175" as="geometry" />
        </mxCell>

        <mxCell id="env" value="&lt;b&gt;任务执行环境 E 与轨迹账本&lt;/b&gt;&lt;div style=&quot;font-size:18px;margin-top:6px;line-height:1.4&quot;&gt;产出动作序列、工具回执、内部监控轨迹与候选产物&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fontFamily=PingFang SC;fontSize=22;fontColor=#1f3448;fillColor=#f5f8fc;strokeColor=#728fb0;strokeWidth=2;spacing=12;" vertex="1" parent="1">
          <mxGeometry x="50" y="850" width="560" height="105" as="geometry" />
        </mxCell>

        <mxCell id="frozen" value="&lt;b&gt;受保护冻结边界（Frozen Core）&lt;/b&gt;&lt;div style=&quot;font-size:19px;margin-top:12px;line-height:1.5&quot;&gt;1. 数据隔离：Search / Selection / Held-out Test 三划分&lt;br&gt;&lt;br&gt;2. 准入护栏：修改预算、泛化审查 Critic、回归检查与成本门槛&lt;br&gt;&lt;br&gt;3. 独立评测器 J：禁止任何候选或元算子改写评分逻辑与归档收据&lt;/div&gt;" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=23;fontColor=#1f3448;fillColor=#e4f2ea;strokeColor=#719a80;strokeWidth=2;spacingLeft=20;spacingRight=16;" vertex="1" parent="1">
          <mxGeometry x="670" y="210" width="280" height="650" as="geometry" />
        </mxCell>

        <mxCell id="e1" value="重写诊断与提议策略" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#c49346;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontColor=#1f3448;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="meta" target="mainline">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="H-step / P-step 协同" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#728fb0;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontColor=#1f3448;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="mainline" target="weights">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="驱动交互" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#526b81;strokeWidth=2;fontFamily=PingFang SC;fontSize=18;fontColor=#1f3448;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="weights" target="env">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="e4" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#719a80;strokeWidth=2;dashed=1;dashPattern=6 5;exitX=1;exitY=0.5;entryX=0;entryY=0.16;" edge="1" parent="1" source="meta" target="frozen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#719a80;strokeWidth=2;dashed=1;dashPattern=6 5;exitX=1;exitY=0.5;entryX=0;entryY=0.45;" edge="1" parent="1" source="mainline" target="frozen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#719a80;strokeWidth=2;exitX=1;exitY=0.5;entryX=0;entryY=0.88;" edge="1" parent="1" source="env" target="frozen">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="caption" value="橙色：元改进层　蓝色：主线 Harness 层　紫色：联合优化与外延层　绿色：不可越界的验证与评测核" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontFamily=PingFang SC;fontSize=19;fontColor=#42586e;fontStyle=0;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="50" y="980" width="900" height="40" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
