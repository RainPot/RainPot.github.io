<mxfile host="app.diagrams.net" agent="Codewiz" version="24.7.17">
  <diagram id="artemis-target-safety-net" name="几何净化、三级定位与SafetyNet自愈">
    <mxGraphModel dx="1000" dy="720" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="960" pageHeight="690" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="ARTEMIS 为什么点得既快又准：五步几何净化、三级渐进定位与动作前 Safety Net 自愈" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=16;fontStyle=1;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="20" y="12" width="920" height="28" as="geometry" />
        </mxCell>

        <!-- Layer 1: 5-step UI Geometric Purification -->
        <mxCell id="l1_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EFF6FF;strokeColor=#2563EB;strokeWidth=1.5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="48" width="920" height="142" as="geometry" />
        </mxCell>
        <mxCell id="l1_lbl" value="第一层：送入模型前的五步确定性 UI 树几何净化（0 模型开销，消除滑出界外、底部栏遮挡与无文本自绘盲区）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#1E40AF;" vertex="1" parent="1">
          <mxGeometry x="34" y="54" width="890" height="22" as="geometry" />
        </mxCell>

        <mxCell id="p1" value="&lt;b&gt;1. 祖先容器裁剪&lt;/b&gt;&lt;br&gt;&lt;code&gt;_clip_bounds&lt;/code&gt;&lt;br&gt;按父滚动容器裁剪越界子项，剔除微米噪点" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="32" y="84" width="168" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="&lt;b&gt;2. 顶/底系统栏钳制&lt;/b&gt;&lt;br&gt;&lt;code&gt;_clamp_by_fixed_bars&lt;/code&gt;&lt;br&gt;识别固定导航栏，静默丢弃露头 &lt;code&gt;≤20px&lt;/code&gt; 细条" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="212" y="84" width="172" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p3" value="&lt;b&gt;3. 父子去重与兄弟合并&lt;/b&gt;&lt;br&gt;&lt;code&gt;ui_filter.py&lt;/code&gt;&lt;br&gt;可点击父节点下唯一文本与图标合并为 &lt;code&gt;[Icon]&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="396" y="84" width="172" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p4" value="&lt;b&gt;4. 双频段 OCR-XML 融合&lt;/b&gt;&lt;br&gt;&lt;code&gt;fuse_ocr_with_xml&lt;/code&gt;&lt;br&gt;剔除 &gt;10% 巨型容器，按 90%/70% 重叠度行聚合" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="580" y="84" width="172" height="92" as="geometry" />
        </mxCell>
        <mxCell id="p5" value="&lt;b&gt;5. 互遮挡告警与 Hint&lt;/b&gt;&lt;br&gt;&lt;code&gt;visualization.py&lt;/code&gt;&lt;br&gt;非同心重叠 ≥50% 注入 &lt;code&gt;WARNING&lt;/code&gt;；暴露 Hint/Error" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#3B82F6;strokeWidth=1.5;fontSize=11.5;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="764" y="84" width="164" height="92" as="geometry" />
        </mxCell>

        <!-- Layer 2: Progressive 3-Tier Grounding -->
        <mxCell id="l2_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ECFDF5;strokeColor=#059669;strokeWidth=1.5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="206" width="920" height="156" as="geometry" />
        </mxCell>
        <mxCell id="l2_lbl" value="第二层：Explorer 渐进式目标定位（先用 0 Token 结构化快路径解决确定目标，仅把模糊目标交给空间视觉模型）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#065F46;" vertex="1" parent="1">
          <mxGeometry x="34" y="212" width="890" height="22" as="geometry" />
        </mxCell>

        <mxCell id="g0" value="&lt;b&gt;Level 0：结构化精确预检（0 模型调用 · &lt;1ms）&lt;/b&gt;&lt;br&gt;&lt;code&gt;ScreenIndex._structural_prepass()&lt;/code&gt; 对 &lt;code&gt;|&lt;/code&gt; 分隔查询做归一化精确匹配&lt;br&gt;若唯一命中（XML 优先于 OCR），直接返回 &lt;code&gt;[0,1000]&lt;/code&gt; 坐标与 bounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="34" y="242" width="400" height="104" as="geometry" />
        </mxCell>

        <mxCell id="g1" value="&lt;b&gt;Level 1/2/3：未命中或多重歧义时按 Tier 调用视觉引擎&lt;/b&gt;&lt;br&gt;• &lt;b&gt;flash&lt;/b&gt;（1 轮）：调用具身空间模型 &lt;code&gt;gemini-robotics-er-2-preview&lt;/code&gt;&lt;br&gt;• &lt;b&gt;pro&lt;/b&gt;（3 轮）/ &lt;b&gt;ultra&lt;/b&gt;（8 轮 + Context Caching）：UI 树搜索 + 局部放大 + OCR&lt;br&gt;• &lt;b&gt;边界校验&lt;/b&gt;：&lt;code&gt;_enrich_candidates()&lt;/code&gt; 要求点落在元素框 2% 容差内才继承 bounds" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#10B981;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="514" y="242" width="412" height="104" as="geometry" />
        </mxCell>

        <mxCell id="e_g0_g1" value="未命中/歧义" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#059669;strokeWidth=1.5;fontSize=11;fontColor=#065F46;labelBackgroundColor=#ECFDF5;" edge="1" parent="1" source="g0" target="g1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Layer 3: Pre-Execution Safety Net, Coordinate Self-Healing & Burst -->
        <mxCell id="l3_bg" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;strokeWidth=1.5;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="20" y="378" width="920" height="292" as="geometry" />
        </mxCell>
        <mxCell id="l3_lbl" value="第三层：动作真正落指前的双轨执行控制（解决“模型思考的 5–15 秒内屏幕刚好发生位移或弹窗遮挡”）" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=13;fontStyle=1;fontColor=#9F1239;" vertex="1" parent="1">
          <mxGeometry x="34" y="384" width="890" height="22" as="geometry" />
        </mxCell>

        <!-- Single Action Track -->
        <mxCell id="v_xml" value="&lt;b&gt;单动作轨道 A：实时 XML Safety Net（最多 3 次 × 0.4s 重试）&lt;/b&gt;&lt;br&gt;四信号合成：&lt;code&gt;W_ID=0.5, W_TEXT=0.4, W_BOUNDS=0.3, W_COORD=0.3&lt;/code&gt; × 距离衰减&lt;br&gt;排除宽高比失配 &gt;2.5x 的巨型容器，计算总分 &lt;code&gt;score&lt;/code&gt; 与身份分 &lt;code&gt;identity_score&lt;/code&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="34" y="414" width="416" height="74" as="geometry" />
        </mxCell>

        <mxCell id="v_heal" value="&lt;b&gt;原地坐标自愈（Coordinate Self-Healing）&lt;/b&gt;&lt;br&gt;若 &lt;code&gt;score ≥ 阈值&lt;/code&gt; 且位移 &lt;code&gt;≤ 200 × scale_factor&lt;/code&gt; 像素：&lt;br&gt;直接把动作坐标修正为实时新中心点并下发，&lt;b&gt;省去重跑一轮 Operator！&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DCFCE7;strokeColor=#16A34A;strokeWidth=1.5;fontSize=12;fontColor=#14532D;" vertex="1" parent="1">
          <mxGeometry x="514" y="414" width="412" height="74" as="geometry" />
        </mxCell>

        <mxCell id="v_pixel" value="&lt;b&gt;Pixel VLM 兜底校验（precondition_pixel.py）&lt;/b&gt;&lt;br&gt;XML 不可用或未过检时，调用 &lt;code&gt;gemini-3.5-flash-lite&lt;/code&gt; 对比决策图与实时图红点位置；仅当判定消失且 &lt;code&gt;confidence ≥ 0.7&lt;/code&gt; 才拦截（低置信度放行防卡死）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#E11D48;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="34" y="514" width="416" height="70" as="geometry" />
        </mxCell>

        <mxCell id="v_inc" value="&lt;b&gt;结构化 Execution Incident（无独立黑盒修复 Agent）&lt;/b&gt;&lt;br&gt;拦截后精确归类为 &lt;code&gt;TARGET_SHIFTED&lt;/code&gt;（附新坐标）、&lt;code&gt;TARGET_OCCUPIED&lt;/code&gt;（附遮挡物名称）或 &lt;code&gt;TARGET_DISAPPEARED&lt;/code&gt;，钉在 Operator 尾部直至后续动作成功" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="514" y="514" width="412" height="70" as="geometry" />
        </mxCell>

        <!-- Multi Action Burst Track -->
        <mxCell id="v_burst" value="&lt;b&gt;多动作轨道 B：Fast-Action Burst（单轮 2–4 个动作，专克自动消失菜单 / Toast / 播放器控制条）&lt;/b&gt;&lt;br&gt;故意跳过 Safety Net、跳过中间截图、不做本地重试，背靠背极速连发抢占瞬态 UI 时间窗口；一旦某步报错立即中止剩余动作并标为 &lt;code&gt;Skipped (burst aborted)&lt;/code&gt;，交由 Execution Incident 恢复。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9333EA;strokeWidth=1.5;fontSize=12;fontColor=#1E293B;" vertex="1" parent="1">
          <mxGeometry x="34" y="596" width="892" height="60" as="geometry" />
        </mxCell>

        <mxCell id="e_v1" value="通过" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#16A34A;strokeWidth=1.5;fontSize=11;fontColor=#14532D;labelBackgroundColor=#FFF1F2;" edge="1" parent="1" source="v_xml" target="v_heal">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_v2" value="兜底" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#E11D48;strokeWidth=1.5;fontSize=11;fontColor=#9F1239;labelBackgroundColor=#FFF1F2;" edge="1" parent="1" source="v_xml" target="v_pixel">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_v3" value="拦截" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#D97706;strokeWidth=1.5;fontSize=11;fontColor=#92400E;labelBackgroundColor=#FFF1F2;" edge="1" parent="1" source="v_pixel" target="v_inc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
