<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram name="目标定位与安全执行">
    <mxGraphModel dx="1700" dy="1100" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1700" math="0" shadow="0" background="#ffffff">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="目标定位不是一次视觉猜测，而是一条逐级收窄的证据链" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;fontSize=26;fontStyle=1;fontFamily=PingFang SC;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="80" y="30" width="2400" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="当前屏幕&#xa;截图 + UIAutomator / Helper UI 树 + OCR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=18;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="80" y="180" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="4" value="ScreenIndex&#xa;可见文本、bounds、resource id、交互属性&#xa;XML 优先，OCR 作为补充" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="520" y="180" width="370" height="130" as="geometry" />
        </mxCell>
        <mxCell id="5" value="唯一精确匹配？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1000" y="170" width="250" height="150" as="geometry" />
        </mxCell>
        <mxCell id="6" value="直接候选&#xa;不调用模型&#xa;返回坐标 + bounds + source" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1370" y="90" width="310" height="130" as="geometry" />
        </mxCell>
        <mxCell id="7" value="Explorer 分层&#xa;Flash：1 回合&#xa;Pro：最多 3 回合&#xa;Ultra：最多 8 回合 + OCR / 图像工具" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1370" y="360" width="310" height="170" as="geometry" />
        </mxCell>
        <mxCell id="8" value="目标候选&#xa;标签 + 归一化坐标 + 边界&#xa;标签必须落在元素内部（约 2% 容差）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1770" y="180" width="340" height="130" as="geometry" />
        </mxCell>
        <mxCell id="9" value="Operator 动作&#xa;索引目标 → 归一化 [0,1000] 坐标&#xa;坐标目标必须带 target_description" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="2200" y="180" width="360" height="130" as="geometry" />
        </mxCell>
        <mxCell id="10" value="动作数量？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=18;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="2670" y="170" width="220" height="150" as="geometry" />
        </mxCell>
        <mxCell id="11" value="单动作&#xa;Safety Net&#xa;XML-first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=18;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="2230" y="650" width="280" height="130" as="geometry" />
        </mxCell>
        <mxCell id="12" value="XML 校验&#xa;id .5 / text .4 / bounds .3 / coord .3&#xa;最多 3 次，每次间隔 0.4s" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=16;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1730" y="650" width="370" height="140" as="geometry" />
        </mxCell>
        <mxCell id="13" value="Pixel fallback&#xa;新截图 + 目标裁剪&#xa;缺失置信度 ≥ 0.7 才拦截" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1230" y="650" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="14" value="通过后分发&#xa;普通动作失败最多本地重试 2 次&#xa;Safety Net 只保证目标仍像原来" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="750" y="650" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="15" value="Burst&#xa;2+ 动作连续发送&#xa;无 Safety Net、无中间截图、无重试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="2230" y="980" width="330" height="140" as="geometry" />
        </mxCell>
        <mxCell id="16" value="第一处失败&#xa;剩余动作标记 Skipped&#xa;打开 Execution Incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1730" y="980" width="350" height="140" as="geometry" />
        </mxCell>
        <mxCell id="17" value="下一轮 Operator&#xa;看到失败类别、原因和证据&#xa;下一次成功动作后关闭 incident" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=17;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="1160" y="980" width="400" height="140" as="geometry" />
        </mxCell>
        <mxCell id="18" value="注意：Validator 的成功含义是命令已分发，不等同于业务效果已确认；最终效果由下一帧、Operator 和 Checker 共同判断。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=16;fontFamily=PingFang SC;fontColor=#374151;" vertex="1" parent="1">
          <mxGeometry x="80" y="1320" width="1050" height="90" as="geometry" />
        </mxCell>
        <mxCell id="19" value="结构化证据" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=14;fontFamily=PingFang SC;" vertex="1" parent="1">
          <mxGeometry x="80" y="1500" width="150" height="38" as="geometry" />
