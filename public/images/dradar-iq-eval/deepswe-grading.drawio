<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="31.0.2">
  <diagram name="deepswe-grading">
    <mxGraphModel dx="0" dy="0" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="730" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="DeepSWE 单次判分：三段式执行与 F2P/P2P 白名单" style="text;html=1;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="350" y="16" width="800" height="30" as="geometry" />
        </mxCell>
        <mxCell id="laneAgent" value="Agent 容器（一次性，网络隔离）" style="swimlane;startSize=30;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="390" height="330" as="geometry" />
        </mxCell>
        <mxCell id="a1" value="题面 instruction.md + 真实仓库代码&#xa;固定 base_commit，来自活跃开源项目" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="laneAgent">
          <mxGeometry x="30" y="50" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="a2" value="no-network 网络隔离 · 90 分钟限时&#xa;2 CPU / 8 GB 独立配额" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="laneAgent">
          <mxGeometry x="30" y="140" width="330" height="60" as="geometry" />
        </mxCell>
        <mxCell id="a3" value="agent 自由解题：改代码、跑测试、自查&#xa;完成后 git commit" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="laneAgent">
          <mxGeometry x="30" y="220" width="330" height="70" as="geometry" />
        </mxCell>
        <mxCell id="collect" value="[[verifier.collect]] 钩子&#xa;git diff --binary base..HEAD&#xa;→ 提取 model.patch（唯一判分依据）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="160" width="300" height="140" as="geometry" />
        </mxCell>
        <mxCell id="laneVerifier" value="Verifier 容器（pristine，与 Agent 环境分离）" style="swimlane;startSize=30;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="840" y="70" width="580" height="360" as="geometry" />
        </mxCell>
        <mxCell id="v1" value="① 在 base 上应用 model.patch&#xa;应用失败 → apply_failed=1、reward=0，不再跑测试" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="laneVerifier">
          <mxGeometry x="30" y="50" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v2" value="② 应用 test.patch：注入隐藏测试&#xa;测试只存在于判分环境，Agent 环境里根本没有" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="laneVerifier">
          <mxGeometry x="30" y="125" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v3" value="③ 跑完整测试套件&#xa;产出 base-ctrf.json / new-ctrf.json 机器可读报告" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;" vertex="1" parent="laneVerifier">
          <mxGeometry x="30" y="200" width="520" height="60" as="geometry" />
        </mxCell>
        <mxCell id="v4" value="④ grader.py 按 F2P/P2P 白名单判分" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;fontSize=12;fontStyle=1;" vertex="1" parent="laneVerifier">
          <mxGeometry x="30" y="275" width="520" height="55" as="geometry" />
        </mxCell>
        <mxCell id="f2pBox" value="F2P / P2P 双白名单（tests/config.json）&#xa;&#xa;F2P fail-to-pass：修复前失败、修复后必须通过——证明问题被解决&#xa;P2P pass-to-pass：原本就通过、修复后仍须通过——证明没改坏别的&#xa;&#xa;reward = 1 ⟺ |F2P| &gt; 0 且 F2P 全过 且 P2P 无一失败&#xa;worst-status-wins：同一测试多报告取最差；白名单测试没出现在报告里按 failed 计" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;align=left;spacingLeft=14;verticalAlign=top;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="470" width="390" height="220" as="geometry" />
        </mxCell>
        <mxCell id="rewardBox" value="reward.json&#xa;reward：0/1 二元（排名口径）&#xa;f2p / p2p / partial：连续部分分（诊断口径）&#xa;另附 ctrf.json、test-stdout.txt、run.log、reports/" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="840" y="480" width="580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="aggBox" value="服务端聚合（mode: equal_latest_3）&#xa;每个格子取最近 3 次有效判分，等权平均&#xa;Σ样本分 ÷ 样本总数 × 150 = 模型档位 IQ" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="480" y="610" width="580" height="90" as="geometry" />
        </mxCell>
        <mxCell id="e1" value="agent 提交" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="laneAgent" target="collect">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="model.patch" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="collect" target="laneVerifier">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3" value="判分产物" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="laneVerifier" target="rewardBox">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="有效判分" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="rewardBox" target="aggBox">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1130" y="590" />
              <mxPoint x="770" y="590" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" value="白名单约束" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=11;dashed=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=1;entryDx=0;entryDy=0;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="f2pBox" target="laneVerifier">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="700" y="525" />
              <mxPoint x="700" y="465" />
              <mxPoint x="1210" y="465" />
            </Array>
          </mxGeometry>
        </mxCell>
      </root>
    </mxGraphModel>
