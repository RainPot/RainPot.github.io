        <mxCell id="13" value="当前屏幕" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;fontSize=22;strokeColor=#666666;" edge="1" parent="1" source="5" target="6">
