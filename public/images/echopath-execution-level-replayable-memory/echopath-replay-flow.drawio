<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="drawio" version="26.0.0">
  <diagram name="EchoPath 重放流程">
    <mxGraphModel dx="1600" dy="1200" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1400" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="2" value="一次重放不是“照着旧坐标点一遍”" style="text;html=1;align=left;verticalAlign=middle;fontSize=38;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="50" y="30" width="1500" height="60" as="geometry" />
        </mxCell>
        <mxCell id="3" value="它先判断这条记忆是否适用于当前任务和当前桌面，再逐步把旧动作实例化成当前动作。" style="text;html=1;align=left;verticalAlign=middle;fontSize=24;fontColor=#4b5563;" vertex="1" parent="1">
          <mxGeometry x="50" y="100" width="1500" height="45" as="geometry" />
        </mxCell>
        <mxCell id="4" value="任务输入 + 当前桌面状态" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=30;fontStyle=1;fontColor=#333333;" vertex="1" parent="1">
          <mxGeometry x="100" y="220" width="300" height="100" as="geometry" />
        </mxCell>
        <mxCell id="5" value="检索 active memories&#xa;按意图、应用、任务类型召回" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=28;fontStyle=1;fontColor=#4b3b00;" vertex="1" parent="1">
          <mxGeometry x="500" y="220" width="360" height="100" as="geometry" />
        </mxCell>
        <mxCell id="6" value="Compatibility gate&#xa;生命周期 / 校验 / 动作 / 前置条件" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=28;fontStyle=1;fontColor=#4b3b00;" vertex="1" parent="1">
          <mxGeometry x="960" y="220" width="400" height="100" as="geometry" />
        </mxCell>
        <mxCell id="7" value="当前记忆&#xa;可安全重放？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=30;fontStyle=1;fontColor=#4b3b00;" vertex="1" parent="1">
          <mxGeometry x="1030" y="430" width="260" height="150" as="geometry" />
        </mxCell>
        <mxCell id="8" value="仅重绑定声明过的输入&#xa;URL / 文件名 / 表单值 / 文本" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=28;fontStyle=1;fontColor=#5b3a00;" vertex="1" parent="1">
          <mxGeometry x="520" y="650" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="9" value="IBTR / IMTR&#xa;用 target crop 在当前截图中重瞄准" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontSize=28;fontStyle=1;fontColor=#5b3a00;" vertex="1" parent="1">
          <mxGeometry x="520" y="830" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="10" value="ActionLens&#xa;执行 + before/after 观测" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=30;fontStyle=1;fontColor=#1f2937;" vertex="1" parent="1">
          <mxGeometry x="520" y="1010" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="11" value="Step / artifact evaluator&#xa;结果成立才保留这条路径" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=28;fontStyle=1;fontColor=#234b25;" vertex="1" parent="1">
          <mxGeometry x="520" y="1190" width="400" height="110" as="geometry" />
        </mxCell>
        <mxCell id="12" value="拒绝直接重放&#xa;局部 grounding repair，或回到普通规划" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=28;fontStyle=1;fontColor=#6b1c18;" vertex="1" parent="1">
          <mxGeometry x="1210" y="650" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="13" value="局部 repair 仍失败&#xa;任务级 fallback" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=28;fontStyle=1;fontColor=#6b1c18;" vertex="1" parent="1">
          <mxGeometry x="1210" y="850" width="330" height="120" as="geometry" />
        </mxCell>
        <mxCell id="14" value="绿色：可复用　橙色：重放时绑定　红色：拒绝与回退" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9ca3af;fontSize=22;fontColor=#374151;" vertex="1" parent="1">
