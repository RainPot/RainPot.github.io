---
import { ClientRouter } from "astro:transitions";
import CosmicBackground from "../components/CosmicBackground.astro";
import CustomCursor from "../components/CustomCursor.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

type Props = {
  title?: string;
  description?: string;
};

const {
  title = "RainPot",
  description = "RainPot 的前端、AI Agent 与工程实践笔记。"
} = Astro.props;
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0d1117" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <ClientRouter />
  </head>
  <body>
    <CustomCursor />
    <CosmicBackground />
    <div class="page-shell">
      <Header />
      <slot />
      <footer class="footer">
        <div class="footer-meta">
          <span class="footer-copy">
            <span>Copyright © 2026 RainPot</span>
            <span class="footer-counts">
              <span>浏览次数 <span id="busuanzi_site_pv">加载中...</span></span>
              <span>/</span>
              <span>访客 <span id="busuanzi_site_uv">加载中...</span></span>
            </span>
          </span>
          <a href="#top">回到顶部</a>
        </div>
      </footer>
    </div>
    <script>
      // 不蒜子计数：ClientRouter 下静态 <script src> 只在首次整页加载执行一次，
      // 改为每次页面加载后重新注入脚本，SPA 导航到新页面也能刷新浏览/访客计数
      document.addEventListener("astro:page-load", () => {
        document.getElementById("busuanzi-loader")?.remove();
        const script = document.createElement("script");
        script.id = "busuanzi-loader";
        script.src = "https://cdn.busuanzi.cc/busuanzi/3.6.9/busuanzi.min.js";
        document.body.appendChild(script);
      });
    </script>
  </body>
</html>
