---
import { Image } from "astro:assets";
import { imageMetadata } from "astro/assets/utils";
import type { ImageMetadata } from "astro";
import { createHash } from "node:crypto";
import { readFile } from "node:fs/promises";
import { resolve } from "node:path";
import { getPostSlug, type BlogPostLike } from "../lib/blog";

type Props = {
  post: BlogPostLike;
  href: string;
  large?: boolean;
  pagedOut?: boolean;
  eager?: boolean;
};

const { post, href, large = false, pagedOut = false, eager = false } = Astro.props;
const date = post.data.date.toISOString().slice(0, 10);
const tags = post.data.tags ?? [];
const title = post.data.title;
const description = post.data.description ?? "";
const slug = getPostSlug(post);
const body = post.body ?? "";
// 搜索按字段分开给分，所以这里不再拼成一整段文本
const filterMeta = [slug, ...tags].join(" ");
// public 中的图片按需读取，避免批量导入时把未使用的原图复制进构建产物。
const sourceImages = import.meta.glob<{ default: ImageMetadata }>("../images/**/*.{png,jpg,jpeg,webp,gif,svg,avif}");
const thumbnailSrc = await getThumbnailSrc(body);

async function getThumbnailSrc(markdown: string): Promise<ImageMetadata | string> {
  const matches = [
    ...markdown.matchAll(/!\[[^\]]*]\(([^)\n]+)\)/g),
    ...markdown.matchAll(/<img\b[^>]*\bsrc=["']([^"']+)["']/gi)
  ].sort((left, right) => (left.index ?? 0) - (right.index ?? 0));

  for (const match of matches) {
    const src = await normalizeImageSrc(match[1]);
    if (src) return src;
  }
  return "";
}

async function normalizeImageSrc(src: string): Promise<ImageMetadata | string> {
  const value = src
    .trim()
    .replace(/^<|>$/g, "")
    .replace(/\s+["'][^"']*["']$/, "");

  if (/^(https?:|data:|blob:)/i.test(value)) return value;
  const sourceSrc = await sourceImageSrc(value);
  if (sourceSrc) return sourceSrc;
  if (value.startsWith("/")) return value;
  if (value.startsWith("../../images/")) return `/images/${value.slice("../../images/".length)}`;
  if (value.startsWith("../images/")) return `/images/${value.slice("../images/".length)}`;
  if (value.startsWith("./images/")) return `/images/${value.slice("./images/".length)}`;
  if (value.startsWith("images/")) return `/${value}`;
  return "";
}

async function sourceImageSrc(src: string): Promise<ImageMetadata | undefined> {
  const pathname = src.split(/[?#]/)[0];
  const relativePath = pathname.startsWith("/images/")
    ? pathname.slice("/images/".length)
    : pathname.startsWith("../../images/")
      ? pathname.slice("../../images/".length)
      : pathname.startsWith("../images/")
        ? pathname.slice("../images/".length)
        : pathname.startsWith("./images/")
          ? pathname.slice("./images/".length)
          : pathname.startsWith("images/")
            ? pathname.slice("images/".length)
            : "";

  if (!relativePath) return undefined;
  try {
    const decodedPath = decodeURIComponent(relativePath);
    const sourceImage = sourceImages[`../images/${decodedPath}`];
    if (!src.startsWith("/") && sourceImage) return (await sourceImage()).default;

    const publicPath = resolve("public/images", decodedPath);
    try {
      const data = await readFile(publicPath);
      const metadata = await imageMetadata(data, publicPath);
      // 原图内容变化时同步更新缩略图地址，避免命中旧构建缓存。
      const version = createHash("sha256").update(data).digest("hex").slice(0, 12);
      return { ...metadata, src: `${import.meta.env.BASE_URL}images/${encodeURI(decodedPath)}?v=${version}` };
    } catch {
      return sourceImage ? (await sourceImage()).default : undefined;
    }
  } catch {
    return undefined;
  }
}
---

<a class:list={["article-card", { featured: large, "has-thumbnail": Boolean(thumbnailSrc), "is-page-hidden": pagedOut }]} href={href} data-filter-card data-filter-key={slug} data-filter-title={title} data-filter-meta={filterMeta} data-filter-summary={description} data-spotlight-card>
  {thumbnailSrc && (
    <span class="article-card-thumb" aria-hidden="true">
      <Image
        src={thumbnailSrc}
        alt=""
        width={320}
        height={200}
        widths={[160, 320, 640, 960]}
        sizes="(max-width: 560px) calc(100vw - 62px), 156px"
        format="webp"
        quality={75}
        fit="cover"
        loading={eager ? "eager" : "lazy"}
        decoding="async"
      />
    </span>
  )}
  <div class="article-card-main">
    <div class="card-meta">
      <span>{date}</span>
      {tags.slice(0, 2).map((tag) => <span>{tag}</span>)}
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
  </div>
  <span class="card-arrow" aria-hidden="true">→</span>
</a>
